#!/usr/bin/env bash
set -euo pipefail

cd "$(dirname "$0")"

# Charger .env si présent
if [ -f ".env" ]; then
  set -a
  . ./.env
  set +a
fi

# Valeurs par défaut si non définies
: "${BEZA_ADDR:=:8088}"

# Dépendances sqlite (si besoin, on te donnera la commande exacte)
go mod tidy >/dev/null 2>&1 || true

echo "Nehemiah starting on ${BEZA_ADDR}"
go run ./cmd/api
